{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "tomylana93/jcf",
    "type": "project",
    "description": "A modern, modular starterkit for building simple, purposeful applications.",
    "keywords": [
        "jalara",
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/chisel": "^0.1.0",
        "laravel/fortify": "^1.37.2",
        "laravel/framework": "^13.17",
        "laravel/reverb": "^1.12",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.14",
        "spatie/laravel-backup": "^10.3",
        "spatie/laravel-medialibrary": "^11.23",
        "spatie/laravel-permission": "^8.3",
        "spatie/laravel-query-builder": "^7.3",
        "spatie/laravel-settings": "^3.9"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.6",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.9",
        "laravel/boost": "^2.2",
        "laravel/installer": "5.32.0",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-browser": "^5.1",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.2",
        "pestphp/pest-plugin-rector": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan init:prepare --no-interaction",
            "@php artisan init:app --no-interaction",
            "pnpm install --frozen-lockfile",
            "@build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "dev:frontend": "pnpm run dev",
        "build": "pnpm run build",
        "build:ssr": "pnpm run build:ssr",
        "check": "pnpm run check",
        "check:fix": "pnpm run check:fix",
        "format": "pnpm run format",
        "format:check": "pnpm run format:check",
        "types:check": "pnpm run types:check",
        "lint": [
            "rector",
            "pint --parallel",
            "@check:fix"
        ],
        "test:type-coverage": "pest --type-coverage --min=100",
        "test:prepare": "@build:ssr",
        "test:audit": [
            "composer audit --abandoned=report",
            "pnpm audit"
        ],
        "test:feature": "pest --compact --parallel --exclude-testsuite=Browser",
        "test:feature-build": "pest tests/Acceptance/FeatureBuildTest.php --compact",
        "test:lint": [
            "pint --parallel --test",
            "rector --dry-run",
            "@check"
        ],
        "test:browser": [
            "@test:prepare",
            "@test:browser:run"
        ],
        "test:browser:run": "pest tests/Browser --compact",
        "test:unit": "@php tests/run-coverage.php",
        "test:types": [
            "phpstan analyse",
            "@types:check"
        ],
        "test:backend": [
            "@test:audit",
            "@test:feature-build",
            "@test:prepare",
            "@test:lint",
            "@test:types",
            "@test:type-coverage",
            "@test:unit",
            "@test:browser:run"
        ],
        "test": [
            "@test:backend"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan init:prepare --no-interaction",
            "@php bootstrap/finalize-project.php"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "installer": {
                "post-create-project": [
                    "@php bootstrap/install-project.php --prepare"
                ]
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
